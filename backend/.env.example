# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Firebase Service Account
# Download serviceAccountKey.json from Firebase Console and place it in backend/src/config/
# Never commit this file to version control
FIREBASE_CONFIG_PATH=./src/config/serviceAccountKey.json

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Email Configuration (Optional - for custom email services)
EMAIL_SERVICE=firebase
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=your_sendgrid_key_here

# Database
DATABASE_URL=your_database_url_if_using_external_db

# Logging
LOG_LEVEL=debug
